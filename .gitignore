# large source datasets — never committed.
# ANCHORED with a leading slash: an unanchored `data/` also matches `web/data/`,
# which silently un-tracks the app's OWN data and ships a site that renders nothing.
/data/
*.tif
*.tiff
*.nc

# reference material used as a STANDARD: measured against, never reproduced
reference/

venv/
__pycache__/
.DS_Store
scratchpad/

# rewritten by every audit run
Research/modeling/epic_scores_cur.json
Research/modeling/clearsky_scores_clr.json
Research/modeling/cloud_texture_cur.json
Research/figures/clouds/*_cur.jpg
# a machine-local launch config with an absolute path
.claude/launch.json
